{
  "name": "ripple",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RIPPLE — a gesture-controlled, GPU-simulated digital water surface.",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch-model": "node scripts/fetch-model.mjs",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
